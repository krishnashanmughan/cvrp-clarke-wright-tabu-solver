   "source": [
    "### Capacitated Vehicle Routing Problem (CVRP) Solver\n",
    "**Methodology:** Clarke-Wright Savings Heuristic Initialization + Tabu Search (Mixed Neighborhoods)\n",
    "\n",
    "This notebook processes VRP benchmark instances, generates an initial solution using the Clarke-Wright savings heuristic, and optimizes the routes using a Tabu Search metaheuristic with 2-Opt and inter-route relocation operators."
   ]
  },
  {
   "cell_type": "markdown",
   "id": "db1d1c32",
   "metadata": {},
   "source": [
    "**Problem** : |Find the best routes for vehicles to deliver goods to customers.\n",
    "\n",
    "**Constraints**\n",
    "- Each vehicle has a capacity (Q).\n",
    "- Every customer is visited exactly once.\n",
    "- All vehicles start and end at a depot."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 80,
   "id": "778d101b",
   "metadata": {},
   "outputs": [],
   "source": [
    "#import libraries\n",
    "import os\n",
    "import copy\n",
    "import time\n",
    "import random\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "from pathlib import Path\n",
    "import matplotlib.pyplot as plt\n",
    "from vrp_instance_reader import read_vrp_instance"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "cca69218",
   "metadata": {},
   "source": [
    "#### 1. Initial Solution: Clarke-Wright Savings Heuristic\n",
    "Generates a fast, greedy initial solution by calculating the savings of merging two routes and merging them sequentially based on capacity constraints."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 81,
   "id": "adac11ce",
   "metadata": {},
   "outputs": [],
   "source": [
    "def clarke_wright(df, Q, distance):\n",
    "    \"\"\"\n",
    "    Parallel Clarke-Wright Savings Heuristic for CVRP.\n",
    "    \"\"\"\n",
    "    n = len(df)\n",
    "    \n",
    "    # Initialize one route per customer\n",
    "    routes = {i: [0, i, 0] for i in range(1, n)}\n",
    "    route_load = {i: int(df.loc[i, \"demand\"]) for i in range(1, n)}\n",
    "    \n",
    "    # Compute all potential savings: s(i,j) = d(0,i) + d(0,j) - d(i,j)\n",
    "    savings = []\n",
    "    for i in range(1, n):\n",
    "        for j in range(i + 1, n):\n",
    "            s = distance[0, i] + distance[0, j] - distance[i, j]\n",
    "            savings.append((i, j, s))\n",
    "            \n",
    "    savings.sort(key=lambda x: -x[2])\n",
    "    \n",
    "    # Greedy merge\n",
    "    for i, j, _ in savings:\n",
    "        route_i = routes[i]\n",
    "        route_j = routes[j]\n",
    "        \n",
    "        if route_i is route_j:\n",
    "            continue\n",
    "            \n",
    "        # i must be last in its route, j must be first in its route\n",
    "        if route_i[-2] != i or route_j[1] != j:\n",
    "            continue\n",
    "            \n",
    "        # Check vehicle capacity constraint\n",
    "        if route_load[i] + route_load[j] <= Q:\n",
    "            new_route = route_i[:-1] + route_j[1:]\n",
    "            new_load = route_load[i] + route_load[j]\n",
    "            \n",
    "            for node in new_route:\n",
    "                if node != 0:\n",
    "                    routes[node] = new_route\n",
    "                    route_load[node] = new_load\n",
    "                    \n",
    "    # Deduplicate routes using tuples for hashing\n",
    "    seen = set()\n",
    "    unique_routes = []\n",
    "    for route in routes.values():\n",
    "        key = tuple(route)\n",
    "        if key not in seen:\n",
    "            seen.add(key)\n",
    "            unique_routes.append(route)\n",
    "            \n",
    "    return unique_routes"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "8c867481",
   "metadata": {},
   "source": [
    "#### 2. Metaheuristic: Tabu Search & Local Operators"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 82,
   "id": "0c39b301",
   "metadata": {},
   "outputs": [],
   "source": [
    "def route_distance(route, distance):\n",
    "    return sum(distance[route[k], route[k + 1]] for k in range(len(route) - 1))\n",
    "\n",
    "def total_distance(routes, distance):\n",
    "    return sum(route_distance(r, distance) for r in routes)\n",
    "\n",
    "def route_load(route, demand):\n",
    "    return sum(demand[node] for node in route if node != 0)\n",
    "\n",
    "def two_opt_move(route, i, j):\n",
    "    \"\"\"Reverses the segment route[i+1 : j+1].\"\"\"\n",
    "    return route[:i + 1] + route[i + 1:j + 1][::-1] + route[j + 1:]\n",
    "\n",
    "def two_opt_delta(route, i, j, distance):\n",
    "    \"\"\"O(1) calculation for change in route cost after 2-opt.\"\"\"\n",
    "    a, b = route[i], route[i + 1]\n",
    "    c, d = route[j], route[j + 1]\n",
    "    return (distance[a, c] + distance[b, d]) - (distance[a, b] + distance[c, d])\n",
    "\n",
    "def relocate_delta(route_from, p, route_to, q, distance):\n",
    "    \"\"\"O(1) calculation for change in route cost after moving a node.\"\"\"\n",
    "    u = route_from[p]\n",
    "    a, b = route_from[p - 1], route_from[p + 1]\n",
    "    delta_remove = distance[a, b] - distance[a, u] - distance[u, b]\n",
    "\n",
    "    x, y = route_to[q], route_to[q + 1]\n",
    "    delta_insert = distance[x, u] + distance[u, y] - distance[x, y]\n",
    "    \n",
    "    return delta_remove + delta_insert\n",
    "\n",
    "def apply_relocate(routes, r_from, p, r_to, q):\n",
    "    \"\"\"Actually applies the relocation and cleans up empty routes.\"\"\"\n",
    "    new_routes = copy.deepcopy(routes)\n",
    "    u = new_routes[r_from].pop(p)\n",
    "\n",
    "    if r_from == r_to and p < q + 1:\n",
    "        q -= 1\n",
    "        \n",
    "    new_routes[r_to].insert(q + 1, u)\n",
    "    return [r for r in new_routes if not (len(r) == 2 and r[0] == 0 and r[1] == 0)]"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "4adc87e6",
   "metadata": {},
   "source": [
    "#### Tabu Search Algorithm (Optimized)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 83,
   "id": "1497fd61",
   "metadata": {},
   "outputs": [],
   "source": [
    "def tabu_search_mixed(initial_routes, distance, df, Q, max_iter=500, tabu_tenure=25, \n",
    "                      max_no_improve=120, neighbor_span_2opt=30, sample_relocate_pairs=200, \n",
    "                      vehicle_penalty=5000):\n",
    "    EPS = 1e-9\n",
    "    demand = df[\"demand\"].to_dict()\n",
    "\n",
    "    current_routes = [r[:] for r in initial_routes]\n",
    "    best_routes = [r[:] for r in initial_routes]\n",
    "\n",
    "    current_dist = total_distance(current_routes, distance)\n",
    "    current_active_vehicles = sum(1 for r in current_routes if len(r) > 2)\n",
    "    current_cost = current_dist + (current_active_vehicles * vehicle_penalty)\n",
    "    \n",
    "    best_dist, best_cost = current_dist, current_cost\n",
    "    history = [best_dist]\n",
    "\n",
    "    current_loads = [route_load(r, demand) for r in current_routes]\n",
    "    tabu = {}\n",
    "    no_improve = 0\n",
    "\n",
    "    for it in range(max_iter):\n",
    "        best_move_type = None\n",
    "        best_move_args = None\n",
    "        best_move_key = None\n",
    "        best_move_cost = float(\"inf\")\n",
    "        best_new_dist = 0\n",
    "        best_new_vehicles = current_active_vehicles\n",
    "\n",
    "        # -------------------------\n",
    "        # A) INTRA-ROUTE 2-OPT\n",
    "        # -------------------------\n",
    "        for r_idx, route in enumerate(current_routes):\n",
    "            if len(route) <= 4: continue\n",
    "            for i in range(1, len(route) - 2):\n",
    "                j_max = min(len(route) - 1, i + neighbor_span_2opt)\n",
    "                for j in range(i + 1, j_max):\n",
    "                    cand_dist = current_dist + two_opt_delta(route, i, j, distance)\n",
    "                    cand_cost = cand_dist + (current_active_vehicles * vehicle_penalty) # Vehicle count stays same\n",
    "\n",
    "                    a, b, c, d = route[i], route[i+1], route[j], route[j+1]\n",
    "                    move_key = (\"2opt\", r_idx, a, b, c, d)\n",
    "\n",
    "                    if (tabu.get(move_key, -1) <= it or cand_cost < best_cost - EPS) and cand_cost < best_move_cost - EPS:\n",
    "                        best_move_key = move_key\n",
    "                        best_move_type = '2opt'\n",
    "                        best_move_args = (r_idx, i, j)\n",
    "                        best_move_cost = cand_cost\n",
    "                        best_new_dist = cand_dist\n",
    "                        best_new_vehicles = current_active_vehicles\n",
    "\n",
    "        # -------------------------\n",
    "        # B) INTER-ROUTE RELOCATE\n",
    "        # -------------------------\n",
    "        R = len(current_routes)\n",
    "        pairs = [(r1, r2) for r1 in range(R) for r2 in range(R) if r1 != r2]\n",
    "        if len(pairs) > sample_relocate_pairs:\n",
    "            pairs = random.sample(pairs, sample_relocate_pairs)\n",
    "\n",
    "        for r_from, r_to in pairs:\n",
    "            route_from, route_to = current_routes[r_from], current_routes[r_to]\n",
    "            if len(route_from) <= 2: continue \n",
    "\n",
    "            # Check if moving a node from route_from will empty the route\n",
    "            vehicle_reduction = 1 if len(route_from) == 3 else 0\n",
    "            cand_active_vehicles = current_active_vehicles - vehicle_reduction\n",
    "\n",
    "            for p in range(1, len(route_from) - 1):\n",
    "                u = route_from[p]\n",
    "                if current_loads[r_to] + demand[u] > Q: continue\n",
    "\n",
    "                for q in range(0, len(route_to) - 1):\n",
    "                    cand_dist = current_dist + relocate_delta(route_from, p, route_to, q, distance)\n",
    "                    \n",
    "                    # Compute cost mathematically in O(1) without deepcopying\n",
    "                    cand_cost = cand_dist + (cand_active_vehicles * vehicle_penalty)\n",
    "\n",
    "                    move_key = (\"reloc\", u, r_from, r_to)\n",
    "                    if (tabu.get(move_key, -1) <= it or cand_cost < best_cost - EPS) and cand_cost < best_move_cost - EPS:\n",
    "                        best_move_key = move_key\n",
    "                        best_move_type = 'reloc'\n",
    "                        best_move_args = (r_from, p, r_to, q)\n",
    "                        best_move_cost = cand_cost\n",
    "                        best_new_dist = cand_dist\n",
    "                        best_new_vehicles = cand_active_vehicles\n",
    "\n",
    "        if best_move_type is None: break\n",
    "\n",
    "        # -------------------------\n",
    "        # APPLY THE BEST MOVE ONCE\n",
    "        # -------------------------\n",
    "        if best_move_type == '2opt':\n",
    "            r_idx, i, j = best_move_args\n",
    "            current_routes[r_idx] = two_opt_move(current_routes[r_idx], i, j)\n",
    "        elif best_move_type == 'reloc':\n",
    "            r_from, p, r_to, q = best_move_args\n",
    "            current_routes = apply_relocate(current_routes, r_from, p, r_to, q)\n",
    "            current_loads = [route_load(r, demand) for r in current_routes]\n",
    "\n",
    "        current_dist = best_new_dist\n",
    "        current_cost = best_move_cost\n",
    "        current_active_vehicles = best_new_vehicles\n",
    "\n",
    "        tabu[best_move_key] = it + tabu_tenure + random.randint(0, 5)\n",
    "\n",
    "        if current_cost < best_cost - EPS:\n",
    "            best_cost, best_dist = current_cost, current_dist\n",
    "            best_routes = [r[:] for r in current_routes]\n",
    "            no_improve = 0\n",
    "        else:\n",
    "            no_improve += 1\n",
    "\n",
    "        history.append(best_dist)\n",
    "        if no_improve >= max_no_improve: break\n",
    "\n",
    "    return best_routes, best_dist, history"
   ]
  },
