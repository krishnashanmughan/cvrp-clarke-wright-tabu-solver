    "def discover_instances(root_dir):\n",
    "    root = Path(root_dir)\n",
    "    instance_files = [str(f) for f in sorted(root.rglob(\"*.TXT\"))]\n",
    "    \n",
    "    return instance_files\n",
    "\n",
    "def run_tabu_instance(file_path, max_iter=200, tabu_tenure=15, neighbor_span_2opt=30, sample_relocate_pairs=200):\n",
    "    dist_matrix, df, K, Q = read_vrp_instance(file_path)\n",
    "    distance = dist_matrix\n",
    "\n",
    "    t0 = time.perf_counter()\n",
    "    cw_routes = clarke_wright(df, Q, distance)\n",
    "    cw_time = (time.perf_counter() - t0) * 1000\n",
    "    cw_dist = total_distance(cw_routes, distance)\n",
    "\n",
    "    t1 = time.perf_counter()\n",
    "    ts_routes, ts_dist, history = tabu_search_mixed(\n",
    "        cw_routes, distance, df, Q,\n",
    "        max_iter=max_iter, tabu_tenure=tabu_tenure,\n",
    "        max_no_improve=max_iter // 2,\n",
    "        neighbor_span_2opt=neighbor_span_2opt,\n",
    "        sample_relocate_pairs=sample_relocate_pairs\n",
    "    )\n",
    "    ts_time = (time.perf_counter() - t1)\n",
    "    improvement = ((cw_dist - ts_dist) / cw_dist) * 100 if cw_dist > 0 else 0\n",
    "\n",
    "    return {\n",
    "        \"instance\": os.path.basename(file_path),\n",
    "        \"customers\": len(df) - 1,\n",
    "        \"cw_dist\": round(cw_dist, 2),\n",
    "        \"ts_dist\": round(ts_dist, 2),\n",
    "        \"improvement\": round(improvement, 2),\n",
    "        \"cw_time_s\": round(cw_time, 1),\n",
    "        \"ts_time_s\": round(ts_time, 1),\n",
    "        \"num_routes\": len(ts_routes)\n",
    "    }\n",
    "\n",
    "if __name__ == \"__main__\":\n",
    "    ROOT = \r"data/vrp_dataset\"\n",
    "    \n",
    "    if not os.path.exists(ROOT):\n",
    "        print(f\"❌ Directory not found: {ROOT}\")\n",
    "    else:\n",
    "        files = discover_instances(ROOT)\n",
    "\n",
    "        if not files:\n",
    "            print(f\"❌ No .TXT instances found in {ROOT} or its subfolders.\")\n",
    "        else:\n",
    "            print(f\"🔹 Found {len(files)} instances across all subfolders. Running Tabu Search...\")\n",
    "            for idx, fp in enumerate(files, 1):\n",
    "                try:\n",
    "                    res = run_tabu_instance(fp)\n",
    "                    print(f\"[{idx}/{len(files)}] {res['instance']:<15s} \"\n",
    "                          f\"Nodes={res['customers']:>2d} | \"\n",
    "                          f\"Routes={res['num_routes']:>2d} | \"\n",
    "                          f\"CW={res['cw_dist']:>8.2f} | \"\n",
    "                          f\"TS={res['ts_dist']:>8.2f} | \"\n",
    "                          f\"Imp={res['improvement']:>5.2f}% | \"\n",
    "                          f\"Time={res['ts_time_s']:>6.1f}s\")\n",
    "                except Exception as e:\n",
    "                    print(f\"Error processing {os.path.basename(fp)}: {e}\")"
   ]
  }
